# Vercel Deployment Environment Configuration
# Copy this file to .env.local for local development
# Set these variables in the Vercel dashboard for production

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Public URL where the frontend is hosted
NEXT_PUBLIC_APP_URL=https://pam.your-domain.com

# API endpoint (backend service URL)
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# WebSocket endpoint for real-time features
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com

# ============================================================================
# BACKEND CONFIGURATION (for API routes if using Next.js API routes)
# ============================================================================

# Database connection string (Vercel Postgres)
DATABASE_URL=postgres://default:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Redis connection string (Vercel Redis)
REDIS_URL=redis://default:YOUR_PASSWORD@upstash-redis-rest-url.upstash.io:6379

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-key-here

# Session encryption key (generate with: openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=your-session-encryption-key-here

# Argon2 password hashing configuration
ARGON2_SECRET=your-argon2-secret-here
ARGON2_OPS_LIMIT=3
ARGON2_MEM_LIMIT=65536
ARGON2_TIME_COST=3

# ============================================================================
# OAUTH / OIDC PROVIDERS
# ============================================================================

# Google OIDC
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://pam.your-domain.com/auth/callback/google

# Microsoft Entra ID
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_REDIRECT_URI=https://pam.your-domain.com/auth/callback/entra

# ============================================================================
# ENCRYPTION (Local Development KMS Stub)
# ============================================================================

# Master key for envelope encryption (development only)
# In production, use Cloud KMS (AWS KMS, Azure Key Vault, GCP KMS)
LOCAL_KMS_MASTER_KEY=your-32-byte-base64-encoded-key-here

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=https://pam.your-domain.com,https://www.pam.your-domain.com

# ============================================================================
# RATE LIMITING
# ============================================================================

# Requests per minute per IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Authentication attempts
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

# Session duration in milliseconds (24 hours)
SESSION_DURATION_MS=86400000

# Idle timeout in milliseconds (30 minutes)
IDLE_TIMEOUT_MS=1800000

# ============================================================================
# LAUNCH GRANT CONFIGURATION
# ============================================================================

# Launch grant lifetime in milliseconds (30 seconds)
LAUNCH_GRANT_LIFETIME_MS=30000

# ============================================================================
# AUDIT & LOGGING
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Audit log retention in days
AUDIT_RETENTION_DAYS=365

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# SMTP configuration (for email notifications)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@pam.your-domain.com

# ============================================================================
# CONNECTOR CONFIGURATION
# ============================================================================

# Connector gateway URL (for outbound-only connectors)
CONNECTOR_GATEWAY_URL=https://connector.pam.your-domain.com

# Connector shared secret (for mTLS authentication)
CONNECTOR_SHARED_SECRET=your-connector-shared-secret

# ============================================================================
# BROWSER EXTENSION
# ============================================================================

# Extension ID (Chrome Web Store)
EXTENSION_ID=your-extension-id

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable demo tenant seeding
ENABLE_DEMO_TENANT=true

# Enable break-glass access
ENABLE_BREAK_GLASS=false

# Enable audit hash chaining
ENABLE_AUDIT_HASH_CHAINING=true

# Enable password rotation
ENABLE_PASSWORD_ROTATION=true

# Enable session recording
ENABLE_SESSION_RECORDING=false
