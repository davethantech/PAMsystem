# Frontend Development Dockerfile for Keyrail PAM Cloud
# Optimized for hot-reloading and development

FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
COPY package-lock.json ./

# Install dependencies
RUN npm install

# Copy source files
COPY src ./src
COPY public ./public
COPY index.html ./
COPY tsconfig.json ./
COPY vite.config.js ./

# Create non-root user
RUN addgroup -S keyrail && adduser -S keyrail -G keyrail
USER keyrail

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

# Start development server
CMD ["npm", "run", "dev"]
