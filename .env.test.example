# Keyrail PAM Cloud - Test Environment Configuration
# 
# This file contains example configuration for test environments.
# Copy to .env.test and customize for your CI/CD pipeline.
#
# NEVER commit this file to version control with real values.
#
# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Application
PORT=8080
NODE_ENV=test

# Database - Use test-specific database
DATABASE_URL=postgres://keyrail:keyrail-test-only@localhost:5432/keyrail_test
PG_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Security - Cookie Secret (must be different from dev/prod)
COOKIE_SECRET=test-secret-64-bytes-please-change-me

# Issuer URL
ISSUER=https://pam.test.keyrail.local

# Session Configuration
SESSION_TTL_MIN=60
IDLE_TIMEOUT_MIN=5

# =============================================================================
# KMS CONFIGURATION
# =============================================================================
# For test environments, use "local" provider
KMS_PROVIDER=local
KMS_KEY_ID=

# =============================================================================
# OIDC / SSO PROVIDERS (Optional for tests)
# =============================================================================
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
ENTRA_TENANT_ID=test-tenant-id
ENTRA_CLIENT_ID=test-client-id
ENTRA_CLIENT_SECRET=test-client-secret

# =============================================================================
# TEST-SPECIFIC CONFIGURATION
# =============================================================================
# Enable test mode features
TEST_MODE=true

# Test database cleanup
TEST_DB_CLEANUP=true

# Test user credentials
TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=Test-Password-123!
TEST_USER_EMAIL=user@test.local
TEST_USER_PASSWORD=Test-Password-456!

# =============================================================================
# RATE LIMITING (higher for tests)
# =============================================================================
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MINUTES=1

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug

# =============================================================================
# NOTES
# =============================================================================
# 1. Test environment should use separate database from development
# 2. All test credentials should be clearly marked as TEST ONLY
# 3. Test environment should be isolated from production
# 4. Consider using ephemeral containers for test runs
# 5. Test data should be cleaned up after test completion
