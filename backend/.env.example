# Keyrail backend — copy to .env (never commit real values)
PORT=8080
DATABASE_URL=postgres://keyrail:keyrail-dev-only@localhost:5432/keyrail
REDIS_URL=redis://localhost:6379
PG_SSL=false

# KMS: "aws" in cloud (HSM-backed), "local" for dev only (ephemeral in-memory master key)
KMS_PROVIDER=local
KMS_KEY_ID=arn:aws:kms:ap-southeast-2:000000000000:key/00000000-0000-0000-0000-000000000000

# 64 bytes: openssl rand -hex 32
COOKIE_SECRET=change-me

ISSUER=https://pam.example.com
SESSION_TTL_MIN=120
IDLE_TIMEOUT_MIN=15

# OIDC providers (optional — enable SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
