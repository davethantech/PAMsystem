# Backend Development Dockerfile for Keyrail PAM Cloud
# Optimized for hot-reloading and development

FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
COPY package-lock.json ./

# Install dependencies (including devDependencies)
RUN npm install

# Copy source files
COPY src ./src
COPY tsconfig.json ./

# Create non-root user
RUN addgroup -S keyrail && adduser -S keyrail -G keyrail
USER keyrail

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz || exit 1

# Start development server
CMD ["npm", "run", "dev"]
